{
  "name": "stepci",
  "version": "2.8.2",
  "description": "Automated API Testing and Quality Assurance",
  "main": "index.js",
  "bin": {
    "stepci": "dist/index.js"
  },
  "files": [
    "dist",
    "schema.json",
    "npm-shrinkwrap.json",
    "scripts/provenance.cjs",
    "docs/maintainers",
    "runner-revision.json",
    "scripts/action-entrypoint.cjs"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@stepci/plugin-openapi": "0.4.2",
    "@stepci/runner": "https://codeload.github.com/stepci/runner/tar.gz/e8a93ef894c079b19ccd87ed7cdcfcf87f79e7cf",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "exit": "^0.1.2",
    "yargs": "^17.5.1",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.3",
    "@types/exit": "^0.1.31",
    "@types/node": "^20.8.10",
    "@types/yargs": "^17.0.13",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.3",
    "typescript-json-schema": "^0.62.0",
    "vitepress": "1.6.4",
    "vue": "^3.2.41",
    "@types/js-yaml": "4.0.9"
  },
  "scripts": {
    "prebuild": "node scripts/check-toolchain.cjs && node scripts/verify-runner-source.cjs && node scripts/clean.cjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "typescript-json-schema --required --esModuleInterop node_modules/@stepci/runner/dist/index.d.ts Workflow -o schema.json && node scripts/provenance.cjs write",
    "build:watch": "tsc -w -p tsconfig.json",
    "init": "ts-node ./src/index.ts init",
    "pretest": "npm run build",
    "test": "node scripts/provenance.cjs verify && node --test tests/*.test.cjs",
    "test:manual": "ts-node ./src/index.ts run -v",
    "package": "npm run build && node scripts/package.cjs",
    "prepack": "node -e \"throw new Error('Use npm run package to include the dependency lock')\"",
    "test:package": "node scripts/test-package.cjs",
    "verify": "npm test && npm run test:package && npm run docs:build",
    "test:generate": "ts-node ./src/index.ts generate",
    "test:loadtest": "ts-node ./src/index.ts run --loadtest",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "node scripts/check-toolchain.cjs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "test:regressions": "node --test tests/regressions.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rclevenger-hm/stepci.git"
  },
  "keywords": [
    "http",
    "testing",
    "api"
  ],
  "author": "Mish Ushakov <mish@stepci.com>",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/stepci/stepci/issues"
  },
  "homepage": "https://stepci.com",
  "overrides": {
    "parse-duration": "2.1.9",
    "@faker-js/faker": "10.6.0",
    "jsonpath-plus": "10.4.0",
    "vite": "6.4.4",
    "basic-ftp": "6.2.2",
    "json-schema-ref-parser": "npm:@apidevtools/json-schema-ref-parser@11.7.2"
  }
}
