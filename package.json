{
  "name": "stepci",
  "version": "2.8.2",
  "description": "Automated API Testing and Quality Assurance",
  "main": "index.js",
  "bin": {
    "stepci": "dist/index.js"
  },
  "files": [
    "dist",
    "schema.json",
    "npm-shrinkwrap.json",
    "scripts/provenance.cjs",
    "docs/maintainers"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@stepci/plugin-openapi": "0.3.5",
    "@stepci/runner": "2.0.0",
    "chalk": "^4.1.2",
    "ci-info": "^3.5.0",
    "cli-highlight": "^2.1.11",
    "conf": "^10.2.0",
    "exit": "^0.1.2",
    "is-docker": "^2.2.1",
    "posthog-node": "^2.2.2",
    "yargs": "^17.5.1"
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.3",
    "@types/exit": "^0.1.31",
    "@types/node": "^20.8.10",
    "@types/yargs": "^17.0.13",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.3",
    "typescript-json-schema": "^0.62.0",
    "vitepress": "^1.0.0-rc.24",
    "vue": "^3.2.41"
  },
  "scripts": {
    "prebuild": "node scripts/check-toolchain.cjs && node scripts/clean.cjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "typescript-json-schema --required --esModuleInterop node_modules/@stepci/runner/dist/index.d.ts Workflow -o schema.json && node scripts/provenance.cjs write",
    "build:watch": "tsc -w -p tsconfig.json",
    "init": "ts-node ./src/index.ts init",
    "pretest": "npm run build",
    "test": "node scripts/provenance.cjs verify && node --test tests/cli.test.cjs",
    "test:known": "node --test tests/known-failures.test.cjs",
    "test:manual": "ts-node ./src/index.ts run -v",
    "package": "npm run build && node scripts/package.cjs",
    "prepack": "node -e \"throw new Error('Use npm run package to include the dependency lock')\"",
    "test:package": "node scripts/test-package.cjs",
    "verify": "npm test && npm run test:known && npm run test:package",
    "test:generate": "ts-node ./src/index.ts generate",
    "test:loadtest": "ts-node ./src/index.ts run --loadtest",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "node scripts/check-toolchain.cjs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rclevenger-hm/stepci.git"
  },
  "keywords": [
    "http",
    "testing",
    "api"
  ],
  "author": "Mish Ushakov <mish@stepci.com>",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/stepci/stepci/issues"
  },
  "homepage": "https://stepci.com"
}
